# Environment Configuration for Aegis / Meridian Platform

# Environment Mode: development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gemini AI Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database (PostgreSQL 16 with pgvector)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_password
POSTGRES_DB=aegis_meridian
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secure_password@localhost:5432/aegis_meridian

# Redis (Caching & Ephemeral State)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Event Bus (Redpanda - Kafka Compatible)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Identity & JWT Configuration
JWT_SECRET_KEY=change_this_to_a_random_32_byte_string_for_local_development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Keycloak Integration (for full OIDC end-to-end flows)
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=meridian
KEYCLOAK_CLIENT_ID=meridian-portal
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# Tool Gateway & Autonomy Limits
TOOL_GATEWAY_DEFAULT_AUTONOMY=A1
MAX_AUTONOMOUS_TRANSFER_LIMIT_USD=100.00
REPAIR_AUTO_THRESHOLD_USD=250.00
